{
  "installCommand": "npm install --prefix server",
  "buildCommand": "cd client && rm -f package-lock.json && npm install --no-audit --no-fund && npx vite build",
  "outputDirectory": "client/dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
{
  "installCommand": "npm install --prefix server",
  "buildCommand": "echo 'Using prebuilt client/dist committed to the repo'",
  "outputDirectory": "client/dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
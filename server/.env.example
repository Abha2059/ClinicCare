# Server
PORT=5001
NODE_ENV=development

# MongoDB — local instance or a MongoDB Atlas SRV connection string
MONGODB_URI=mongodb://127.0.0.1:27017/cliniccare

# Auth — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_me_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# CORS origin of the deployed frontend
CLIENT_URL=http://localhost:5173

# ────────────────────────────────────────────────────────────
#  ClinicCare — environment template
#
#  Real values belong in server/.env and client/.env, which are
#  gitignored. Copy the two example files and fill them in:
#
#    cp server/.env.example server/.env
#    cp client/.env.example client/.env
# ────────────────────────────────────────────────────────────

# ---------- server/.env ----------
PORT=5001
NODE_ENV=development

# Local MongoDB, or a MongoDB Atlas SRV connection string
MONGODB_URI=mongodb://127.0.0.1:27017/cliniccare

# Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_me_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# Allowed CORS origin of the deployed frontend
CLIENT_URL=http://localhost:5173

# ---------- client/.env ----------
VITE_API_URL=http://localhost:5001/api
